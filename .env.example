# Environment variable surface for incimin.io AI SRE Agent.
# Copy this file to .env and fill in real values. Never commit .env.
#
# NOTE: The values below use in-network Docker service names.
# Host-side tooling (scripts, notebooks) should use 127.0.0.1 with the
# host ports listed in docs/PORTS.md instead.

# LLM provider: anthropic (default), gemini, or openrouter.
LLM_PROVIDER=openrouter

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-pro-preview

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

MEMGRAPH_HOST=memgraph
MEMGRAPH_PORT=7687


CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=signoz_logs

# --- Incident dashboard API (v1.7) ---
# Postgres holding incidents, agent steps, approvals, and LangGraph checkpoints.
# Host port 5433; see docs/PORTS.md.
DATABASE_URL=postgresql://incimin:incimin@127.0.0.1:5433/incimin
API_HOST=127.0.0.1
API_PORT=8088
# Agent execution knobs (previously undocumented WEBHOOK_* vars).
WEBHOOK_MAX_STEPS=10
WEBHOOK_MAX_CONCURRENCY=2
WEBHOOK_TARGET=agent

# --- Data plane hosts: correcting the container-name defaults above ---
# The agent, API and probes run as HOST processes (uvicorn on 127.0.0.1), not
# inside the compose network, so `memgraph` / `clickhouse` do not resolve for
# them — every data plane is reached over its published loopback port instead
# (see docs/PORTS.md).
#
# These were dead config until the v2 kernel probes started reading them, at
# which point the stale container names became live and every probe failed with
# a name-resolution error that surfaced only as "no evidence found".
#
# Later keys win in a .env file, so these override the values above.
MEMGRAPH_HOST=127.0.0.1
CLICKHOUSE_HOST=127.0.0.1
