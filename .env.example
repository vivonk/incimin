# Environment variable surface for incimin.io AI SRE Agent.
# Copy this file to .env and fill in real values. Never commit .env.
#
# NOTE: The values below use in-network Docker service names.
# Host-side tooling (scripts, notebooks) should use 127.0.0.1 with the
# host ports listed in docs/PORTS.md instead.

# LLM provider: anthropic (default) or gemini.
LLM_PROVIDER=gemini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-pro-preview

MEMGRAPH_HOST=memgraph
MEMGRAPH_PORT=7687

QDRANT_HOST=qdrant
QDRANT_PORT=6333

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=signoz_logs
